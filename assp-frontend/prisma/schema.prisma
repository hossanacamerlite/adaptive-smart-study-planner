generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model user {
  user_id             Int                   @id @default(autoincrement())
  google_id           String?               @db.VarChar(255)
  name                String?               @db.VarChar(100)
  email               String?               @unique(map: "email") @db.VarChar(100)
  profile_picture     String?               @db.Text
  created_at          DateTime?             @default(now()) @db.Timestamp(0)
  first_name          String?               @db.VarChar(100)
  surname             String?               @db.VarChar(100)
  quiz                quiz[]
  quizattempt         quizattempt[]
  studylog            studylog[]
  studyrecommendation studyrecommendation[]
  studysession        studysession[]
  subjects            subjects[]
}

model studysession {
  session_id       Int            @id @default(autoincrement())
  user_id          Int?
  subject          String?        @db.VarChar(100)
  topic            String?        @db.VarChar(255)
  planned_date     DateTime?      @db.Date
  start_time       DateTime?      @db.Time(0)
  end_time         DateTime?      @db.Time(0)
  planned_duration Int?
  status           String?        @db.VarChar(20)
  created_at       DateTime?      @default(now()) @db.DateTime(0)
  day_of_week      String?        @db.VarChar(10)
  actual_end       DateTime?      @db.DateTime(0)
  actual_duration  Int?
  actual_start     DateTime?      @db.DateTime(0)
  subject_id       Int?
  quiz             quiz[]
  stressrecord     stressrecord[]
  studylog         studylog[]
  studynote        studynote[]
  user             user?          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "studysession_ibfk_1")
  subjects         subjects?      @relation(fields: [subject_id], references: [subject_id], onDelete: Cascade)

  @@index([user_id], map: "user_id")
  @@index([subject_id])
}

model studynote {
  note_id            Int           @id @default(autoincrement())
  session_id         Int?
  note_text          String?       @db.Text
  created_at         DateTime?     @default(now()) @db.DateTime(0)
  subjectsSubject_id Int?
  studysession       studysession? @relation(fields: [session_id], references: [session_id], onDelete: Cascade, map: "studynote_ibfk_1")
  subjects           subjects?     @relation(fields: [subjectsSubject_id], references: [subject_id])

  @@index([session_id], map: "session_id")
  @@index([subjectsSubject_id], map: "studynote_subjectsSubject_id_fkey")
}

model quiz {
  quiz_id         Int            @id @default(autoincrement())
  session_id      Int?
  generated_by    String?        @db.VarChar(50)
  difficulty      String?        @db.VarChar(50)
  total_questions Int?
  created_at      DateTime?      @default(now()) @db.DateTime(0)
  subject_id      Int?
  user_id         Int?
  user            user?          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_quiz_user")
  studysession    studysession?  @relation(fields: [session_id], references: [session_id], onDelete: Cascade, map: "quiz_ibfk_1")
  subjects        subjects?      @relation(fields: [subject_id], references: [subject_id])
  quizattempt     quizattempt[]
  quizquestion    quizquestion[]

  @@index([session_id], map: "session_id")
  @@index([subject_id], map: "quiz_subject_id_fkey")
  @@index([user_id], map: "fk_quiz_user")
}

model quizquestion {
  question_id    Int             @id @default(autoincrement())
  quiz_id        Int?
  question_text  String?         @db.Text
  option_a       String?         @db.VarChar(255)
  option_b       String?         @db.VarChar(255)
  option_c       String?         @db.VarChar(255)
  option_d       String?         @db.VarChar(255)
  correct_option String?         @db.Char(1)
  attemptanswer  attemptanswer[]
  quiz           quiz?           @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade, map: "quizquestion_ibfk_1")

  @@index([quiz_id], map: "quiz_id")
}

model quizattempt {
  attempt_id         Int             @id @default(autoincrement())
  quiz_id            Int?
  user_id            Int?
  started_at         DateTime?       @db.DateTime(0)
  finished_at        DateTime?       @db.DateTime(0)
  score              Int?
  time_taken_sec     Int?
  productivity_level Float?
  attemptanswer      attemptanswer[]
  quiz               quiz?           @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade, map: "quizattempt_ibfk_1")
  user               user?           @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "quizattempt_ibfk_2")

  @@index([quiz_id], map: "quiz_id")
  @@index([user_id], map: "user_id")
}

model attemptanswer {
  answer_id       Int           @id @default(autoincrement())
  attempt_id      Int?
  question_id     Int?
  selected_option String?       @db.Char(1)
  is_correct      Boolean?
  quizattempt     quizattempt?  @relation(fields: [attempt_id], references: [attempt_id], onDelete: Cascade, map: "attemptanswer_ibfk_1")
  quizquestion    quizquestion? @relation(fields: [question_id], references: [question_id], onDelete: Cascade, map: "attemptanswer_ibfk_2")

  @@index([attempt_id], map: "attempt_id")
  @@index([question_id], map: "question_id")
}

model stressrecord {
  stress_id    Int           @id @default(autoincrement())
  session_id   Int?
  stress_level Int?
  recorded_at  DateTime?     @default(now()) @db.DateTime(0)
  user_id      Int?
  attempt_id   Int?
  studysession studysession? @relation(fields: [session_id], references: [session_id], onDelete: Cascade, map: "stressrecord_ibfk_1")

  @@index([session_id], map: "session_id")
}

model studylog {
  log_id       Int           @id @default(autoincrement())
  session_id   Int?
  user_id      Int?
  start_time   DateTime?     @db.DateTime(0)
  end_time     DateTime?     @db.DateTime(0)
  duration     Int?
  created_at   DateTime?     @default(now()) @db.DateTime(0)
  studysession studysession? @relation(fields: [session_id], references: [session_id], onDelete: Cascade, map: "studylog_ibfk_1")
  user         user?         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "studylog_ibfk_2")

  @@index([session_id], map: "session_id")
  @@index([user_id], map: "user_id")
}

model studyrecommendation {
  rec_id                Int       @id @default(autoincrement())
  user_id               Int?
  recommended_date      DateTime? @db.Date
  recommended_start     DateTime? @db.Time(0)
  recommended_end       DateTime? @db.Time(0)
  predicted_focus_score Decimal?  @db.Decimal(5, 2)
  model_version         String?   @db.VarChar(50)
  created_at            DateTime? @default(now()) @db.DateTime(0)
  user                  user?     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "studyrecommendation_ibfk_1")

  @@index([user_id], map: "user_id")
}

model subjects {
  subject_id    Int            @id @default(autoincrement())
  user_id       Int?
  name          String?        @db.VarChar(100)
  color         String?        @db.VarChar(20)
  quizzes       quiz[]
  studynotes    studynote[]
  studysessions studysession[]
  user          user?          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}
